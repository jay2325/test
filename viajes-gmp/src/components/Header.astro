---
import { business } from '../config/business';
const nav = [
  { label: 'Mexico Packages', href: '/mexico-vacation-packages/' },
  {
    label: 'Destinations',
    href: '#destinations',
    children: [
      { label: 'Cancún & Riviera Maya', href: '/cancun-riviera-maya-vacation-packages/' },
      { label: 'Los Cabos', href: '/los-cabos-vacation-packages/' },
      { label: 'Oaxaca', href: '/oaxaca-cultural-tours-day-of-the-dead/' },
    ],
  },
  {
    label: 'Group Travel',
    href: '/mexico-group-travel/',
    children: [
      { label: 'Group Travel', href: '/mexico-group-travel/' },
      { label: 'Family Vacations', href: '/mexico-family-vacations/' },
    ],
  },
  { label: 'Weddings', href: '/destination-weddings-mexico/' },
  { label: 'About', href: '/about/' },
  { label: 'Contact', href: '/contact/' },
];

const currentPath = Astro.url.pathname;
---

<header
  id="site-header"
  style="position:sticky;top:0;z-index:50;background:var(--color-warm-white);border-bottom:1px solid #e8e2d8;transition:box-shadow 0.2s;"
>
  <div class="container" style="display:flex;align-items:center;justify-content:space-between;height:68px;gap:1rem;">
    <!-- Logo -->
    <a href="/" aria-label="Viajes GMP — Home" style="display:flex;align-items:center;gap:0.625rem;text-decoration:none;flex-shrink:0;">
      <!-- Inline SVG logomark -->
      <svg width="36" height="36" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <circle cx="18" cy="18" r="18" fill="#0A4F5A"/>
        <path d="M10 20c0-4.4 3.6-8 8-8s8 3.6 8 8" stroke="#F7F1E8" stroke-width="2" stroke-linecap="round" fill="none"/>
        <path d="M14 20l4-6 4 6" stroke="#C7653A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
        <circle cx="18" cy="20" r="2.5" fill="#F7F1E8"/>
      </svg>
      <span style="font-family:'Fraunces',Georgia,serif;font-weight:700;font-size:1.15rem;color:var(--color-charcoal);">Viajes GMP</span>
    </a>

    <!-- Desktop nav -->
    <nav aria-label="Main navigation" style="display:none;" id="desktop-nav">
      <ul style="display:flex;align-items:center;gap:0.25rem;list-style:none;margin:0;padding:0;">
        {nav.map((item) => (
          <li style="position:relative;">
            {item.children ? (
              <div class="nav-dropdown">
                <button
                  class="nav-link"
                  aria-haspopup="true"
                  aria-expanded="false"
                  style={`font-weight:500;font-size:0.9rem;padding:0.5rem 0.75rem;border:none;background:none;cursor:pointer;color:${currentPath.startsWith(item.href ?? '') ? 'var(--color-ocean)' : 'var(--color-charcoal)'};border-radius:6px;display:flex;align-items:center;gap:0.25rem;`}
                >
                  {item.label}
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M3 4.5l3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                <ul class="dropdown-menu" style="display:none;position:absolute;top:100%;left:0;min-width:220px;background:var(--color-warm-white);border:1px solid #e8e2d8;border-radius:10px;padding:0.5rem;box-shadow:0 8px 30px rgba(0,0,0,0.1);list-style:none;margin:0.25rem 0 0 0;">
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        style={`display:block;padding:0.5rem 0.75rem;border-radius:6px;font-size:0.875rem;font-weight:500;color:var(--color-charcoal);text-decoration:none;transition:background-color 0.15s;`}
                        class="dropdown-item"
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ) : (
              <a
                href={item.href}
                class="nav-link"
                style={`font-weight:500;font-size:0.9rem;padding:0.5rem 0.75rem;border-radius:6px;color:${currentPath === item.href ? 'var(--color-ocean)' : 'var(--color-charcoal)'};text-decoration:none;display:block;`}
              >
                {item.label}
              </a>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <!-- Desktop CTA -->
    <div id="desktop-cta" style="display:none;align-items:center;gap:0.75rem;flex-shrink:0;">
      <a href={business.whatsappUrl} class="btn-whatsapp" style="font-size:0.85rem;padding:0.5rem 1rem;" target="_blank" rel="noopener noreferrer">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.123.554 4.118 1.524 5.847L0 24l6.318-1.499A11.956 11.956 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.903 0-3.68-.51-5.21-1.4l-.374-.221-3.752.89.938-3.658-.243-.381A9.945 9.945 0 012 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/></svg>
        WhatsApp
      </a>
      <a href="/contact/" class="btn-primary" style="font-size:0.875rem;padding:0.5625rem 1.125rem;">Request a Quote</a>
    </div>

    <!-- Mobile menu button -->
    <button
      id="mobile-menu-btn"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="mobile-nav"
      style="background:none;border:none;cursor:pointer;padding:0.5rem;color:var(--color-charcoal);border-radius:6px;"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6"/>
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
    </button>
  </div>

  <!-- Mobile nav drawer -->
  <nav
    id="mobile-nav"
    aria-label="Mobile navigation"
    style="display:none;border-top:1px solid #e8e2d8;background:var(--color-warm-white);padding:1rem 1.25rem 1.5rem;"
  >
    <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:0.25rem;">
      {nav.map((item) => (
        <li>
          <a
            href={item.children ? item.children[0].href : item.href}
            style="display:block;padding:0.625rem 0.75rem;font-weight:500;font-size:1rem;color:var(--color-charcoal);text-decoration:none;border-radius:8px;"
          >
            {item.label}
          </a>
          {item.children && (
            <ul style="list-style:none;margin:0;padding:0 0 0 1rem;">
              {item.children.map((child) => (
                <li>
                  <a
                    href={child.href}
                    style="display:block;padding:0.5rem 0.75rem;font-size:0.875rem;color:var(--color-muted);text-decoration:none;border-radius:6px;"
                  >
                    {child.label}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
    <div style="display:flex;flex-direction:column;gap:0.75rem;margin-top:1rem;padding-top:1rem;border-top:1px solid #e8e2d8;">
      <a href={business.whatsappUrl} class="btn-whatsapp" target="_blank" rel="noopener noreferrer" style="justify-content:center;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.123.554 4.118 1.524 5.847L0 24l6.318-1.499A11.956 11.956 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.903 0-3.68-.51-5.21-1.4l-.374-.221-3.752.89.938-3.658-.243-.381A9.945 9.945 0 012 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/></svg>
        Chat on WhatsApp
      </a>
      <a href="/contact/" class="btn-primary" style="justify-content:center;">Request a Quote</a>
    </div>
  </nav>
</header>

<style>
  @media (min-width: 1024px) {
    #desktop-nav { display: flex !important; }
    #desktop-cta { display: flex !important; }
    #mobile-menu-btn { display: none !important; }
  }
  #mobile-nav[data-open] { display: block !important; }
  .nav-link:hover { background-color: var(--color-sand); }
  .dropdown-item:hover { background-color: var(--color-sand); }
  .nav-dropdown:hover .dropdown-menu,
  .nav-dropdown:focus-within .dropdown-menu { display: block !important; }
  .nav-dropdown button[aria-expanded="true"] + .dropdown-menu { display: block !important; }
</style>

<script>
  document.querySelectorAll('.nav-dropdown button').forEach((btn) => {
    btn.addEventListener('click', function(this: HTMLButtonElement) {
      const expanded = this.getAttribute('aria-expanded') === 'true';
      this.setAttribute('aria-expanded', String(!expanded));
    });
    btn.addEventListener('keydown', function(this: HTMLButtonElement, e: Event) {
      if ((e as KeyboardEvent).key === 'Escape') {
        this.setAttribute('aria-expanded', 'false');
        this.focus();
      }
    });
  });
</script>
