---
const items = [
  {
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`,
    title: '20+ years of experience',
    body: 'Travel planning support from a team that knows the details.',
  },
  {
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>`,
    title: 'Mexico-based team',
    body: 'Local coordination for destinations, transfers, hotels and activities.',
  },
  {
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>`,
    title: 'Bilingual planning',
    body: 'English and Spanish support for smoother communication.',
  },
  {
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>`,
    title: 'Custom itineraries',
    body: 'Trips shaped around your dates, budget, group and travel style.',
  },
];
---

<section aria-label="Why travelers choose Viajes GMP" style="background:var(--color-ocean);padding-block:2rem;">
  <div class="container">
    <ul style="list-style:none;margin:0;padding:0;display:grid;grid-template-columns:1fr;gap:1.5rem;" role="list" class="trust-grid">
      {items.map((item) => (
        <li style="display:flex;align-items:flex-start;gap:0.875rem;">
          <span style="flex-shrink:0;color:#5E7D5A;margin-top:2px;" set:html={item.icon}></span>
          <div>
            <strong style="display:block;font-size:0.9rem;font-weight:700;color:#fff;margin-bottom:0.2rem;">{item.title}</strong>
            <span style="font-size:0.85rem;color:rgba(255,255,255,0.72);line-height:1.5;">{item.body}</span>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  @media (min-width: 640px) {
    .trust-grid { grid-template-columns: 1fr 1fr !important; }
  }
  @media (min-width: 1024px) {
    .trust-grid { grid-template-columns: repeat(4, 1fr) !important; }
  }
</style>
