---
import { business } from '../config/business';

interface Props {
  headline?: string;
  body?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  dark?: boolean;
}

const {
  headline = 'Ready to plan Mexico with people who know it?',
  body = 'Tell us your dates, destination ideas and travel style. We will help you compare options and create a trip plan that fits.',
  primaryLabel = 'Request a Custom Quote',
  primaryHref = '/contact/',
  secondaryLabel = 'Chat on WhatsApp',
  secondaryHref = business.whatsappUrl,
  dark = true,
} = Astro.props;
---

<section
  style={`padding-block:4rem;${dark ? 'background:var(--color-ocean);' : 'background:var(--color-sand);'}`}
  aria-labelledby="cta-band-headline"
>
  <div class="container" style="text-align:center;max-width:680px;">
    <h2 id="cta-band-headline" style={`margin-bottom:1rem;${dark ? 'color:#fff;' : ''}`}>{headline}</h2>
    <p style={`margin-bottom:2rem;line-height:1.7;${dark ? 'color:rgba(255,255,255,0.78);' : 'color:var(--color-muted);'}`}>{body}</p>
    <div style="display:flex;flex-wrap:wrap;justify-content:center;gap:1rem;">
      <a href={primaryHref} class="btn-primary">{primaryLabel}</a>
      <div style="display:flex;flex-direction:column;align-items:center;gap:0.25rem;">
        <a href={secondaryHref} class="btn-whatsapp" target="_blank" rel="noopener noreferrer">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.123.554 4.118 1.524 5.847L0 24l6.318-1.499A11.956 11.956 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.903 0-3.68-.51-5.21-1.4l-.374-.221-3.752.89.938-3.658-.243-.381A9.945 9.945 0 012 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/></svg>
          {secondaryLabel}
        </a>
        <p style={`font-size:0.75rem;margin:0;line-height:1.3;${dark ? 'color:rgba(255,255,255,0.65);' : 'color:var(--color-muted);'}`}>Avg. reply within 1 hour · Mon–Sat, 9am–9pm CT</p>
      </div>
    </div>
  </div>
</section>
