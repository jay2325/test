---
import { business } from '../config/business';
const year = new Date().getFullYear();
const navLinks = [
  { label: 'Mexico Packages', href: '/mexico-vacation-packages/' },
  { label: 'Cancún & Riviera Maya', href: '/cancun-riviera-maya-vacation-packages/' },
  { label: 'Los Cabos', href: '/los-cabos-vacation-packages/' },
  { label: 'Oaxaca', href: '/oaxaca-cultural-tours-day-of-the-dead/' },
  { label: 'Family Vacations', href: '/mexico-family-vacations/' },
  { label: 'Group Travel', href: '/mexico-group-travel/' },
  { label: 'Destination Weddings', href: '/destination-weddings-mexico/' },
  { label: 'About', href: '/about/' },
  { label: 'Contact', href: '/contact/' },
];
---

<footer style="background:var(--color-charcoal);color:#d0ccc5;padding-block:4rem 2rem;">
  <div class="container">
    <div style="display:grid;grid-template-columns:1fr;gap:3rem;margin-bottom:3rem;">

      <!-- Brand -->
      <div>
        <a href="/" style="display:inline-flex;align-items:center;gap:0.625rem;text-decoration:none;margin-bottom:1rem;" aria-label="Viajes GMP Home">
          <svg width="36" height="36" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <circle cx="18" cy="18" r="18" fill="#0A4F5A"/>
            <path d="M10 20c0-4.4 3.6-8 8-8s8 3.6 8 8" stroke="#F7F1E8" stroke-width="2" stroke-linecap="round" fill="none"/>
            <path d="M14 20l4-6 4 6" stroke="#C7653A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
            <circle cx="18" cy="20" r="2.5" fill="#F7F1E8"/>
          </svg>
          <span style="font-family:'Fraunces',Georgia,serif;font-weight:700;font-size:1.15rem;color:#fff;">Viajes GMP</span>
        </a>
        <p style="font-size:0.925rem;color:#a8a49f;margin-bottom:1.25rem;max-width:300px;line-height:1.6;">{business.tagline}</p>

        <!-- Contact -->
        <div style="display:flex;flex-direction:column;gap:0.625rem;">
          <a href={business.whatsappUrl} style="display:inline-flex;align-items:center;gap:0.5rem;font-size:0.875rem;color:#25D366;text-decoration:none;" target="_blank" rel="noopener noreferrer">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.123.554 4.118 1.524 5.847L0 24l6.318-1.499A11.956 11.956 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.903 0-3.68-.51-5.21-1.4l-.374-.221-3.752.89.938-3.658-.243-.381A9.945 9.945 0 012 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/></svg>
            WhatsApp
          </a>
          <a href={`mailto:${business.email}`} style="display:inline-flex;align-items:center;gap:0.5rem;font-size:0.875rem;color:#d0ccc5;text-decoration:none;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 7L2 7"/></svg>
            {business.email}
          </a>
          <a href={`tel:${business.phone}`} style="display:inline-flex;align-items:center;gap:0.5rem;font-size:0.875rem;color:#d0ccc5;text-decoration:none;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 10.8 19.79 19.79 0 01.08 2.18 2 2 0 012.08 0h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
            {business.phone}
          </a>
          <p style="display:inline-flex;align-items:flex-start;gap:0.5rem;font-size:0.875rem;color:#a8a49f;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;margin-top:1px;" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
            {business.addressOrServiceArea}
          </p>
        </div>

        <!-- Social -->
        <div style="display:flex;gap:0.75rem;margin-top:1.25rem;">
          {business.instagramUrl !== '[INSTAGRAM_URL]' && (
            <a href={business.instagramUrl} aria-label="Instagram" target="_blank" rel="noopener noreferrer" style="color:#a8a49f;transition:color 0.2s;" class="footer-social">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
            </a>
          )}
          {business.facebookUrl !== '[FACEBOOK_URL]' && (
            <a href={business.facebookUrl} aria-label="Facebook" target="_blank" rel="noopener noreferrer" style="color:#a8a49f;transition:color 0.2s;" class="footer-social">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.413c0-3.026 1.792-4.697 4.533-4.697 1.312 0 2.686.236 2.686.236v2.97h-1.513c-1.491 0-1.956.93-1.956 1.886v2.265h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z"/></svg>
            </a>
          )}
          {business.youtubeUrl !== '[YOUTUBE_URL]' && (
            <a href={business.youtubeUrl} aria-label="YouTube" target="_blank" rel="noopener noreferrer" style="color:#a8a49f;transition:color 0.2s;" class="footer-social">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
            </a>
          )}
          {business.tiktokUrl !== '[TIKTOK_URL]' && (
            <a href={business.tiktokUrl} aria-label="TikTok" target="_blank" rel="noopener noreferrer" style="color:#a8a49f;transition:color 0.2s;" class="footer-social">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.32 6.32 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.69a8.18 8.18 0 004.78 1.52V6.76a4.85 4.85 0 01-1.01-.07z"/></svg>
            </a>
          )}
        </div>
      </div>

      <!-- Navigation -->
      <div>
        <h3 style="font-size:0.8rem;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:#a8a49f;margin-bottom:1rem;font-family:'Inter',sans-serif;">Explore</h3>
        <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:0.5rem;">
          {navLinks.slice(0, 5).map((link) => (
            <li><a href={link.href} style="font-size:0.875rem;color:#d0ccc5;text-decoration:none;transition:color 0.2s;" class="footer-link">{link.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- More links -->
      <div>
        <h3 style="font-size:0.8rem;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:#a8a49f;margin-bottom:1rem;font-family:'Inter',sans-serif;">More</h3>
        <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:0.5rem;">
          {navLinks.slice(5).map((link) => (
            <li><a href={link.href} style="font-size:0.875rem;color:#d0ccc5;text-decoration:none;transition:color 0.2s;" class="footer-link">{link.label}</a></li>
          ))}
          <li><a href={business.privacyPolicyUrl} style="font-size:0.875rem;color:#d0ccc5;text-decoration:none;transition:color 0.2s;" class="footer-link">Privacy Policy</a></li>
          <li><a href={business.termsUrl} style="font-size:0.875rem;color:#d0ccc5;text-decoration:none;transition:color 0.2s;" class="footer-link">Terms & Conditions</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div style="border-top:1px solid rgba(255,255,255,0.08);padding-top:1.5rem;display:flex;flex-direction:column;gap:0.75rem;align-items:flex-start;">
      <p style="font-size:0.8rem;color:#6D716C;">&copy; {year} Viajes GMP. All rights reserved.</p>
      <p style="font-size:0.8rem;color:#6D716C;">Mexico-based travel planning for US and Canadian travelers.</p>
    </div>
  </div>
</footer>

<style>
  .footer-link:hover { color: #fff !important; }
  .footer-social:hover { color: #fff !important; }

  @media (min-width: 768px) {
    footer > .container > div:first-child {
      grid-template-columns: 1.5fr 1fr 1fr !important;
    }
    footer > .container > div:last-child {
      flex-direction: row !important;
      justify-content: space-between;
      align-items: center;
    }
  }
</style>
