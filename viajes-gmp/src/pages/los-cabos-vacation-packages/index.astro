---
import Layout from '../../layouts/Layout.astro';
import TrustBar from '../../components/TrustBar.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import FAQ from '../../components/FAQ.astro';
import CTABand from '../../components/CTABand.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { business } from '../../config/business';

const waUrl = "https://wa.me/18053044306?text=Hi!%20I%27m%20interested%20in%20a%20Los%20Cabos%20trip%20%E2%80%94%20can%20you%20tell%20me%20more%3F";

const highlights = [
  'Resort and boutique hotel recommendations',
  'Airport transfers and private transportation',
  'Boat tours and Arch experiences',
  'Golf and spa planning',
  'Sunset dinners and special occasion support',
  'Family-friendly or adults-only hotel options',
  'Optional add-ons for Todos Santos or Baja experiences',
];

const itinerary = [
  { day: 'Day 1', desc: 'Arrive in Los Cabos and transfer to your hotel.' },
  { day: 'Day 2', desc: 'Beach or pool day with dinner reservation support.' },
  { day: 'Day 3', desc: 'Boat tour, snorkeling, golf, spa or private experience.' },
  { day: 'Day 4', desc: 'Optional day trip to Todos Santos or free day.' },
  { day: 'Day 5', desc: 'Transfer to airport.' },
];

const faqs = [
  { question: 'Is Los Cabos good for families?', answer: 'Yes, though Los Cabos is best known for luxury and adult travel. Several resorts have family-friendly sections with calm pools, kids clubs and beach access. We can identify the right hotel for your family.' },
  { question: 'What is the best time to visit Los Cabos?', answer: 'Los Cabos has year-round sunshine with low humidity. The busiest season runs November through April. Summer can be hot and humid, with occasional tropical storms in September and October. We can help you plan around weather and budget.' },
  { question: 'Can you arrange private boat tours or fishing trips?', answer: 'Yes. We can help coordinate boat tours to the famous Arch at Land\'s End, snorkeling, sunset cruises and fishing trips depending on your interests and group size.' },
  { question: 'Is Los Cabos right for a destination celebration or wedding trip?', answer: 'Los Cabos is a popular destination for birthday trips, bachelor and bachelorette groups, anniversaries and wedding weekends. We can help coordinate hotel options, activities and group logistics.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })),
};
---

<Layout
  title="Los Cabos Vacation Packages | Viajes GMP"
  description="Plan Los Cabos vacations with resort stays, transfers, golf, boating, wellness, activities and custom bilingual support from Viajes GMP."
  jsonLd={faqSchema}
>
  <Breadcrumbs crumbs={[{ label: 'Mexico Packages', href: '/mexico-vacation-packages/' }, { label: 'Los Cabos' }]} />

  <!-- Hero -->
  <section style="background:linear-gradient(135deg,#C7653A 0%,#a8532d 100%);padding-block:5rem 4rem;">
    <div class="container" style="max-width:720px;">
      <p style="font-size:0.8rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:rgba(255,255,255,0.65);margin-bottom:0.875rem;">Los Cabos, Baja California Sur</p>
      <h1 style="margin-bottom:1.25rem;color:#fff;">Plan a Los Cabos Escape With Local Support</h1>
      <p style="font-size:1.05rem;color:rgba(255,255,255,0.85);line-height:1.7;margin-bottom:2rem;">
        Desert landscapes, ocean views, luxury resorts, boating, golf, wellness and celebration trips, coordinated around your dates and travel style.
      </p>
      <p style="font-size:0.875rem;font-weight:600;color:rgba(255,255,255,0.7);margin-bottom:1.5rem;">Best for: Couples · Luxury travelers · Golf trips · Birthdays · Wellness getaways · Family resorts · Celebrations</p>
      <div style="display:flex;flex-wrap:wrap;gap:1rem;">
        <a href="#quote-form" class="btn-primary" style="background:var(--color-ocean);">Plan my Los Cabos trip</a>
        <div style="display:flex;flex-direction:column;gap:0.25rem;">
          <a href={waUrl} class="btn-whatsapp" target="_blank" rel="noopener noreferrer">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.123.554 4.118 1.524 5.847L0 24l6.318-1.499A11.956 11.956 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.903 0-3.68-.51-5.21-1.4l-.374-.221-3.752.89.938-3.658-.243-.381A9.945 9.945 0 012 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/></svg>
            Chat on WhatsApp
          </a>
          <p style="font-size:0.75rem;color:rgba(255,255,255,0.65);margin:0;line-height:1.3;">Avg. reply within 1 hour · Mon–Sat, 9am–9pm CT</p>
        </div>
      </div>
    </div>
  </section>

  <TrustBar />

  <!-- Highlights + Itinerary -->
  <section class="section" style="background:var(--color-warm-white);">
    <div class="container">
      <div style="display:grid;grid-template-columns:1fr;gap:3rem;" class="hl-grid">
        <div>
          <h2 style="margin-bottom:1.5rem;">What we can help plan</h2>
          <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:0.625rem;">
            {highlights.map((h) => (
              <li style="display:flex;gap:0.75rem;align-items:flex-start;font-size:0.925rem;color:var(--color-muted);">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-agave)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;margin-top:2px;" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                {h}
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h2 style="margin-bottom:1.5rem;">Sample 5-day itinerary</h2>
          <div style="display:flex;flex-direction:column;gap:1rem;">
            {itinerary.map((item) => (
              <div style="display:flex;gap:1rem;align-items:flex-start;">
                <span style="flex-shrink:0;font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;color:var(--color-terracotta);background:rgba(199,101,58,0.1);padding:0.25rem 0.625rem;border-radius:20px;white-space:nowrap;">{item.day}</span>
                <p style="font-size:0.9rem;color:var(--color-muted);line-height:1.6;">{item.desc}</p>
              </div>
            ))}
          </div>
          <p style="font-size:0.8rem;color:var(--color-muted);margin-top:1rem;font-style:italic;">Sample itinerary. Actual trip planned around your dates, group and preferences.</p>
        </div>
      </div>
    </div>
  </section>

  <QuoteForm
    title="Request a Los Cabos Quote"
    intro="Cabo can be romantic, luxurious, family-friendly, active or relaxed. We will help match the trip to your expectations."
  />

  <FAQ items={faqs} title="Questions about Los Cabos trips" />

  <CTABand
    headline="Build the right version of Los Cabos"
    body="Cabo can be romantic, luxurious, family-friendly, active or relaxed. We will help match the trip to your expectations."
    primaryLabel="Request a Los Cabos quote"
  />
</Layout>

<style>
  @media (min-width: 768px) {
    .hl-grid { grid-template-columns: 1fr 1fr !important; }
  }
</style>
